# Copy to .env in this folder (n8n-docker/.env).

N8N_VERSION=2.44.6

N8N_RUNNERS_MODE=external
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0
N8N_RUNNERS_AUTH_TOKEN=change-me-runner-auth-token

INSTANCE_AI_BRAVE_SEARCH_API_KEY=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-searxng-secret

# Setup 2: self-hosted sandbox (secrets for the API/runner live in sandbox/.env)
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=change-me-api-key

TZ=Europe/Vienna
GENERIC_TIMEZONE=Europe/Vienna
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Host path to video folders (bind-mounted at /data/videos in the n8n container).
VIDEOS_ROOT=/absolute/path/to/your/videos

# n8n 2.44+ file access for Read/Write Files nodes (semicolon-separated container paths).
N8N_RESTRICT_FILE_ACCESS_TO="/data/videos;/data/youtube-upload;/data/common-skills"
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Copy encryptionKey from the running volume: docker compose exec n8n cat /home/node/.n8n/config
# Do not generate a new key if credentials already exist in n8n-docker_n8n_data.
N8N_ENCRYPTION_KEY=
