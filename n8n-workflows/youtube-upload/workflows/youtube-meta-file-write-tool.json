{
  "id": "39baa951-fdba-4d7c-870c-ac22b056704c",
  "name": "YouTube meta - kiválasztott videómappa fájlírás eszköz",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "videoFolder",
              "type": "string"
            },
            {
              "name": "fileName",
              "type": "string"
            },
            {
              "name": "content",
              "type": "string"
            }
          ]
        }
      },
      "id": "1024280c-3c98-4d57-8367-02c17c70e7aa",
      "name": "AI eszköz bemenete",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// This workflow writes one selected-folder metadata file. Approval and phase selection\n// happen in the parent workflow; user-message keyword matching is deliberately absent.\nconst input = $input.first().json;\nconst videoFolder = String(input.videoFolder ?? '');\nconst fileName = String(input.fileName ?? '');\nif (!/^[A-Za-z0-9][A-Za-z0-9 _.-]{0,119}$/.test(videoFolder) || videoFolder.includes('..')) throw new Error('A kiválasztott videómappa neve érvénytelen.');\nif (!['meta.md','meta.json'].includes(fileName)) throw new Error('Érvénytelen fájlútvonal: csak meta.md vagy meta.json írható a kiválasztott mappán belül; almappa és külső útvonal nem írható.');\nif (typeof input.content !== 'string' || !input.content.trim()) throw new Error('A fájl tartalmának nem üres szövegnek kell lennie.');\nreturn [{json:{videoFolder,fileName,content:input.content,targetPath:`/data/videos/${videoFolder}/${fileName}`}}];\n"
      },
      "id": "cd6feaca-8a37-4c88-8d75-82f1c91b42f0",
      "name": "Útvonal ellenőrzése",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "content",
        "binaryPropertyName": "data",
        "options": {
          "fileName": "={{ $json.fileName }}"
        }
      },
      "id": "f993ee03-f4df-4603-a0dc-cbd7cb0a5d27",
      "name": "Szövegfájl előkészítése",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Útvonal ellenőrzése').first().json.targetPath }}",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "a8592153-d7fd-49c9-9336-5d83aa293363",
      "name": "Read/Write Files - fájl mentése",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "id": "d237fc01-aad4-47d8-b399-e061e897f765",
      "name": "Read/Write Files - mentés visszaolvasása",
      "type": "n8n-nodes-base.readWriteFile",
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Útvonal ellenőrzése').first().json.targetPath }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "position": [
        960,
        0
      ],
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "9b5592d4-16e7-47fa-9dbb-219232f40d37",
      "name": "Mentés tartalmának ellenőrzése",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request = $('Útvonal ellenőrzése').first().json;\nconst actual = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nif (actual !== request.content) throw new Error('A visszaolvasott fájl nem egyezik a menteni kért tartalommal.');\nreturn [{json:{ok:true,verified:true,fileName:request.fileName,targetPath:request.targetPath}}];\n"
      },
      "position": [
        1200,
        0
      ],
      "typeVersion": 2
    }
  ],
