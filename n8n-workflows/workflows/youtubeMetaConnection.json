  "id": "youtubeMetaConnection",
  "name": "YouTube metadata – protected agent connection",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "1e9dceab-e8e3-51e9-9ee8-c2954f78ee17",
      "name": "Protected webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "parameters": {
        "httpMethod": "POST",
        "path": "youtube-meta-connection",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "youtube-meta-connection",
      "credentials": {
        "httpHeaderAuth": {
          "id": "youtubeMetaHeaderAuth",
          "name": "YouTube metadata connection Header Auth"
        }
      }
    },
    {
      "id": "7981f1ec-460c-5014-bd36-26f08a5072d1",
      "name": "Validate and reserve",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "parameters": {
        "executeOnce": true,
        "command": "={{ \"timeout 85s node /data/n8n-workflows/runtime/youtube-meta-connection.js '\" + JSON.stringify({body: $json.body, operation: $json.headers['x-youtube-meta-operation'] || 'update', executionId: $execution.id}).base64Encode() + \"'\" }}"
      },
      "position": [
        240,
        0
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "id": "a685f291-6410-5f2e-b724-a52eec241f90",
      "name": "Parse result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.parse($json.stdout) }}",
        "options": {}
      },
      "position": [
        480,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "id": "846fb05a-0365-5006-bd0f-b75130db9bc9",
      "name": "Is error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-error",
              "leftValue": "={{ $json.response.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        720,
        -80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "id": "b8e77016-1148-5f1d-bb5b-534227170182",
      "name": "Unexpected node error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\"httpCode\": 500, \"response\": {\"status\": \"error\", \"step\": \"workflow\", \"code\": \"NODE_FAILURE\", \"message\": \"Belső n8n node-hiba; ellenőrizd a hibás futást.\", \"partialSuccess\": false, \"youtubeModified\": false, \"executionId\": \"{{ $execution.id }}\"}}",
        "options": {}
      },
      "position": [
        720,
        200
      ]
    },
    {
      "id": "f37d6add-3a2c-5ed4-9b1e-50f25091a380",
      "name": "Respond check",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.response) }}",
        "options": {
          "responseCode": "={{ $json.httpCode }}"
        }
      },
      "position": [
        960,
        -180
      ]
    },
    {
      "id": "9a0d6916-d7e6-5173-a1ce-e8a02003fb71",
      "name": "Respond error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.response) }}",
        "options": {
          "responseCode": "={{ $json.httpCode }}"
        }
      },
      "position": [
        960,
        100
      ]
    },
    {
      "id": "a831f8fa-7727-5c78-bf0d-14c639b0430a",
      "name": "Fail execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "parameters": {
        "errorType": "errorObject",
        "errorObject": "={{ JSON.stringify($json.response) }}"
      },
      "position": [
        1200,
        100
      ]
    }
  ],
